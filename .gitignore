# dependencies
node_modules/

# build output
dist/
.turbo/

# environment — secrets never enter the repo (spec §9)
.env
.env.local

# logs & coverage
*.log
coverage/

# os / editor
.DS_Store
.idea/
.vscode/

# production stack secrets
deploy/.env

# uploaded files (local storage driver). Anchored to the runtime directory: a bare
# `storage/` also matches src/core/storage/, which silently excluded the storage
# service from every clone and broke the first real deploy.
apps/api/storage/
deploy/backups/

# Excalidraw fonts, copied out of node_modules at build time so the board never fetches
# them from a CDN. Generated output, not source.
apps/web/public/excalidraw-assets/
