# On-demand TLS: a client portal appears the moment a slug is set.
#
# Every client gets their own hostname (`duce.finsera.nl`), and there are many more to
# come, so the certificate cannot be a line in this file — it would mean an edit, a
# reload, and a step somebody forgets during onboarding. Caddy issues one per hostname on
# the first TLS handshake instead.
#
# `ask` is what keeps that safe. Anything pointed at this server could otherwise ask for a
# certificate in its own name, and Let's Encrypt counts those against a weekly limit per
# registered domain. The API answers 200 only for the login host and for slugs a client
# actually has, so an unknown name never reaches the certificate authority at all.
#
# Put a `?t=<token>` on the ask URL and set PORTAL_ASK_TOKEN to the same value: the API then
# answers only this question, from here, rather than being an open list of which clients
# exist for anyone who can reach /api.
#
# Note what is NOT here: any hostname with a `*` in it. See the last block for why.
{
	on_demand_tls {
		ask {$PORTAL_ASK_URL:http://api:3001/api/portal-host/check}
	}
}

# Caddy serves the internal SPA and proxies the API on one origin, so the browser sees no
# CORS and cookies/tokens stay same-site.
#
# SITE_ADDRESS is the domain in production (Caddy then provisions TLS automatically)
# and :80 locally.
{$SITE_ADDRESS} {
	encode gzip

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3001}
	}

	handle {
		root * /srv
		# SPA history fallback: unknown paths render index.html so /auth/callback and
		# deep links work on a hard refresh.
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# The login host, which is an ordinary name with an ordinary certificate.
{$PORTAL_AUTH_ADDRESS:portal.localhost} {
	encode gzip
	reverse_proxy {$API_UPSTREAM:api:3001}
}

# Every client's own portal — `duce.finsera.nl` and whatever is added next.
#
# A catch-all rather than `*.finsera.nl`, and that distinction took the site down once.
# A wildcard in a site address is a domain Caddy *manages*, so it tries to obtain a real
# wildcard certificate — which only the DNS-01 challenge can issue, which needs a provider
# plugin this build does not have. The attempt fails, and it does not fail quietly in its
# own corner: TLS stopped being served for every name on the box, `hub` included.
#
# With no host in the address there is nothing to manage in advance, so certificates are
# only ever obtained on demand, one hostname at a time, and only for names the API
# recognises. `hub` and the login host keep their own blocks above, which are more specific
# and so match first, and their certificates are managed the ordinary way.
#
# Locally this is a port nothing publishes, so the block is inert; production sets it to
# `https://`.
{$PORTAL_CLIENT_ADDRESS:localhost:9443} {
	encode gzip

	tls {
		on_demand
	}

	reverse_proxy {$API_UPSTREAM:api:3001}
}
