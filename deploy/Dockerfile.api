# syntax=docker/dockerfile:1
# Multi-stage: build with the full workspace, ship only what runs.
FROM node:24-slim AS build
WORKDIR /repo

RUN corepack enable pnpm

# Manifests first so dependency installation caches independently of source changes.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY packages/note-doc/package.json packages/note-doc/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/portal/package.json apps/portal/
RUN pnpm install --frozen-lockfile

COPY packages packages
COPY apps/api apps/api
COPY apps/portal apps/portal
# Every workspace package that publishes a build, rather than a hand-listed one:
# note-doc was added after this file was written and silently went unbuilt.
#
# The portal bundle is built here too and shipped inside the API image: on a portal host
# the API serves it (Phase 8 §4.3), because only the API can tell a client's page from an
# SPA route. It carries no build-time configuration — no issuer, no client id — since the
# login moved to the server.
RUN pnpm -r --filter "./packages/*" run build \
    && pnpm --filter @platform/api build \
    && pnpm --filter @platform/portal build

# Production dependency tree only, hoisted into apps/api/node_modules so the runtime
# stage needs no pnpm and no symlink farm.
RUN pnpm --filter @platform/api deploy --prod --legacy /out \
    && cp -r apps/api/dist /out/dist \
    && cp -r apps/api/drizzle /out/drizzle \
    && cp -r apps/portal/dist /out/portal

FROM node:24-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORTAL_STATIC_DIR=/app/portal

# Run unprivileged; the node image already provides this user.
COPY --from=build --chown=node:node /out /app

# The upload directory, created here and owned by the user that will write to it.
#
# `storage` is a named volume. Docker seeds a *new* volume from the image's contents at this
# path — including its ownership — and when the path does not exist in the image it creates
# an empty directory owned by root instead. That is what happened: the container runs as
# `node`, every upload called `mkdir` inside a root-owned directory, and every one of them
# failed with EACCES and a 500. Not only logos — documents and pasted note images go through
# the same StorageService.
#
# Creating it here fixes it for any volume made from now on. An *existing* volume is never
# re-seeded, so a deployment that already has one needs its ownership corrected once by hand;
# the runbook says how.
RUN mkdir -p /app/storage && chown node:node /app/storage
USER node

EXPOSE 3001
CMD ["node", "dist/main.js"]
