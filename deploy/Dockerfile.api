# syntax=docker/dockerfile:1
# Multi-stage: build with the full workspace, ship only what runs.
FROM node:24-slim AS build
WORKDIR /repo

RUN corepack enable pnpm

# Manifests first so dependency installation caches independently of source changes.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile

COPY packages packages
COPY apps/api apps/api
RUN pnpm --filter @platform/contracts build && pnpm --filter @platform/api build

# Production dependency tree only, hoisted into apps/api/node_modules so the runtime
# stage needs no pnpm and no symlink farm.
RUN pnpm --filter @platform/api deploy --prod --legacy /out \
    && cp -r apps/api/dist /out/dist \
    && cp -r apps/api/drizzle /out/drizzle

FROM node:24-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production

# Run unprivileged; the node image already provides this user.
COPY --from=build --chown=node:node /out /app
USER node

EXPOSE 3001
CMD ["node", "dist/main.js"]
