# Production stack config. Copy to deploy/.env — that file is gitignored.
#
# Local run and Hetzner use the SAME compose file; only these values differ.

# ── site ────────────────────────────────────────────────────
# Local: leave blank (Caddy serves plain HTTP on HTTP_PORT).
# Hetzner: set to hub.finsera.nl — Caddy then provisions TLS for it.
#
# On the server the ports must be the real ones. Let's Encrypt validates by connecting
# to 80/443 on the name in SITE_ADDRESS, so the 8080/8443 defaults below would leave
# the certificate un-issuable and the site unreachable at its own address.
SITE_ADDRESS=
HTTP_PORT=8080
HTTPS_PORT=8443
# On hub.finsera.nl instead:
# SITE_ADDRESS=hub.finsera.nl
# HTTP_PORT=80
# HTTPS_PORT=443

# ── database ────────────────────────────────────────────────
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=platform

# ── auth (Zitadel Cloud EU — decision D5) ───────────────────
# Public under PKCE. Baked into the SPA at build time, so rebuild after changing.
ZITADEL_ISSUER=https://finsera-dashboard-nsncri.eu1.zitadel.cloud
ZITADEL_CLIENT_ID=383629804357893947

# The role that admits somebody to the internal platform. Provisioning is gated on it
# at CREATION, so an existing user row keeps working whatever the grant says — which is
# why a missing grant stays invisible until the first login against a fresh database.
ZITADEL_INTERNAL_ROLE=internal
ZITADEL_PORTAL_ROLE=portal_client

# The portal's own Zitadel application. Unset means the portal refuses every request;
# equal to ZITADEL_CLIENT_ID is fatal.
ZITADEL_PORTAL_CLIENT_ID=

# Which project's roles count. Read it from GET /api/core/auth/diagnostics once roles
# are arriving — it prints the claim names verbatim. Do not guess it from the token's
# `aud`: one of those entries is the client id.
ZITADEL_PROJECT_ID=

# Deliberately has no default. Anything other than the literal "off" leaves the portal
# role check enforced, so a forgotten or misspelled value cannot disable it (G6).
# PORTAL_ROLE_CHECK=off

# ── LLM (decision D6) ───────────────────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MODEL_STRONG=google:gemini-3.1-pro-preview
MODEL_FAST=google:gemini-3.1-flash-lite

# ── meeting capture (Phase 6c, decision G3) ─────────────────
# Recall connects TO us and streams participant audio, so the base must be an address
# reachable from the internet — the deployed origin, not localhost and not a tunnel.
RECALL_API_KEY=
RECALL_REGION_URL=https://eu-central-1.recall.ai
# RECALL_WEBHOOK_BASE=https://hub.finsera.nl
RECALL_WEBHOOK_BASE=

# ── backups ─────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
# 86400 = daily. Lower it to exercise the backup path when testing.
BACKUP_INTERVAL_SECONDS=86400

# ── off-site copies (deploy/offsite.sh, run from host cron) ──
# Without this every copy of the database lives on the one server that holds the
# database. Any rsync target: a Hetzner Storage Box, a NAS, your own machine.
#   BACKUP_REMOTE=u123456@u123456.your-storagebox.de:/home/finsera
#   BACKUP_REMOTE_SSH_PORT=23        # Storage Box uses 23; most hosts 22
BACKUP_REMOTE=
BACKUP_REMOTE_SSH_PORT=

# Off-site means on somebody else's disk, and these files are client records.
# A passphrase you lose is a backup you cannot read — store it somewhere you trust.
#   BACKUP_ENCRYPT_PASSPHRASE_FILE=/root/.finsera-backup-passphrase
BACKUP_ENCRYPT_PASSPHRASE_FILE=

# Dead man's switch: pinged only when a push fully succeeds, so the alert is the ping
# that never arrives. healthchecks.io's free tier does this and emails you.
BACKUP_HEARTBEAT_URL=
