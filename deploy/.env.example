# Production stack configuration. Copy to deploy/.env — that file is gitignored, and no
# real value belongs in this one.
#
# Local run and Hetzner use the SAME docker-compose.yml; only the values below differ.
#
#   HOW A VALUE REACHES THE API
#   The api service has no `env_file`. Only keys named in the `environment:` block of
#   docker-compose.yml enter the container, so a key set here that compose does not forward
#   reaches the host and stops — indistinguishable from leaving it unset. That has bitten
#   this stack twice (OPENROUTER_API_KEY, then the whole Zitadel block). If you add a key
#   here, add it to docker-compose.yml in the same commit.
#
#   REQUIRED means compose references it with no `${VAR:-default}` fallback: the stack will
#   not come up without it. Everything else is optional, and its default is noted.


# ── site and TLS ─────────────────────────────────────────────────────────────
# Local: leave blank — Caddy serves plain HTTP on HTTP_PORT.
# Hetzner: the domain, e.g. hub.finsera.nl — Caddy then provisions TLS itself.
# default: :80
SITE_ADDRESS=
# default: 8080
HTTP_PORT=
# default: 8443
HTTPS_PORT=

# Stamped into the build label the API serves. Set by deploy/update.sh on a real deploy;
# leave blank by hand.
# default: dev
BUILD_VERSION=
# default: dev
BUILD_COMMIT=
BUILD_TIME=


# ── database ─────────────────────────────────────────────────────────────────
# REQUIRED — all three. Compose builds the API's DATABASE_URL out of them and passes it
# directly, so do NOT set DATABASE_URL here: the compose value wins and yours is ignored.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=


# ── auth: Zitadel Cloud EU (decision D5) ─────────────────────────────────────
# Public values under PKCE — the SPA holds no client secret.
# REQUIRED, e.g. https://your-instance.eu1.zitadel.cloud
ZITADEL_ISSUER=
# REQUIRED — the hub's own application
ZITADEL_CLIENT_ID=
ZITADEL_PROJECT_ID=
# default: internal
ZITADEL_INTERNAL_ROLE=
# default: portal_client
ZITADEL_PORTAL_ROLE=

# Creating a client login from the hub. Unset, the invitation is still written and the
# account is made by hand — the screen says so rather than failing silently.
ZITADEL_ADMIN_TOKEN=
ZITADEL_ORG_ID=
ZITADEL_INVITE_URL=

# Leave UNSET to keep the role gate enforced — that is the point of it (decision G6).
# Set only to disable the gate while Zitadel is not emitting role claims for the portal
# project, in which case access rests on the audience plus the portal.users invitation.
PORTAL_ROLE_CHECK=


# ── client portal, on its own hosts (Phase 8) ────────────────────────────────
# The portal application in Zitadel. Blank client id leaves the portal off — which is
# correct until the application exists: PortalIdentityService refuses to boot sharing the
# hub's client id, because two applications behind one id cannot be told apart by audience.
# Blank secret keeps it a public PKCE application.
ZITADEL_PORTAL_CLIENT_ID=
ZITADEL_PORTAL_CLIENT_SECRET=

# The domain client portals hang off, and the host the login callback lives on.
PORTAL_BASE_DOMAIN=
PORTAL_AUTH_HOST=

# Caddy's side of the same two. A hostname of its own, not a bare port: a port-only HTTPS
# site puts Caddy's automatic HTTP→HTTPS redirect on every host and hijacks the hub.
# default: portal.localhost
PORTAL_AUTH_ADDRESS=
# default: localhost:9443
PORTAL_CLIENT_ADDRESS=

# Signs the in-flight portal login state. No default, and the API refuses to boot in
# production without it. Generate per environment: openssl rand -base64 32
PORTAL_SESSION_SECRET=

# Encrypts the per-page Vercel bypass secrets. Absent, the admin form permanently says it
# cannot store one — and the workaround people reach for is turning Vercel's deployment
# protection off, which is the whole problem this exists to end.
PORTAL_PAGE_KEY=

# Shared with Caddy's on-demand-TLS `ask` URL, so that endpoint answers the reverse proxy
# and not anyone who can reach /api. Unset leaves it open.
PORTAL_ASK_TOKEN=
# default: http://api:3001/api/portal-host/check
PORTAL_ASK_URL=


# ── LLM providers (decision D6) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# default: anthropic:claude-opus-4-8
MODEL_STRONG=
# default: anthropic:claude-haiku-4-5-20251001
MODEL_FAST=
# default: google:gemini-embedding-001
MODEL_EMBEDDING=

# OpenRouter's attribution headers — the one place a runaway spend is visible before the
# invoice, since anonymous traffic cannot be attributed to this app.
PUBLIC_URL=
# What the gateway's dollar prices are converted at, for the cost figures.
# default: 0.92
RATE_USD_PER_EUR=


# ── file storage (Phase 3) ───────────────────────────────────────────────────
# Only the local driver exists; the s3 driver arrives with Hetzner object storage.
# STORAGE_PATH is set by compose to the mounted volume — do not set it here.
# default: local
STORAGE_DRIVER=


# ── meeting capture (Phase 6c, decision G3) ──────────────────────────────────
# Recall.ai joins the Teams meeting as a bot and streams one audio channel per participant
# back to us, each tagged with that person's roster identity.
#
# Keep the EU region. The default in code is Frankfurt; putting the US endpoint here would
# quietly undo the reason this vendor was acceptable at all.
RECALL_API_KEY=
# default: https://eu-central-1.recall.ai
RECALL_REGION_URL=

# Recall connects TO us, so this must be an address Recall can reach from the internet.
# In development that means a tunnel (e.g. `ngrok http 3001`), not localhost. Unset means
# meeting capture refuses to start a bot rather than booking one that can never connect.
RECALL_WEBHOOK_BASE=


# ── backups ──────────────────────────────────────────────────────────────────
# default: 30
BACKUP_RETENTION_DAYS=
# 86400 = daily. Lower it to exercise the backup path when testing.
# default: 86400
BACKUP_INTERVAL_SECONDS=

# Off-site copy (deploy/offsite.sh). Unset BACKUP_REMOTE and the step is skipped entirely.
# rsync/ssh target, e.g. user@host:/path
BACKUP_REMOTE=
BACKUP_REMOTE_SSH_PORT=
# Age of the newest dump the off-site job will accept before it fails loudly.
# default: 1560 (26h — a daily job with slack)
BACKUP_MAX_AGE_MINUTES=
# Path to a file holding the passphrase. Set, dumps are encrypted before they leave.
BACKUP_ENCRYPT_PASSPHRASE_FILE=
# Pinged on a successful off-site run, so a silent failure is visible.
BACKUP_HEARTBEAT_URL=


# ── documents in SharePoint: Microsoft Graph (decision D8) ───────────────────
# Document bytes live in a SharePoint library rather than on the server's disk. Setup is a
# one-time job in the Microsoft 365 tenant plus the seven keys below — section 10 of
# docs/deploy-runbook.md walks the tenant side, and it matters: the Entra application must
# hold Sites.Selected granted `write` on that ONE site, never Sites.ReadWrite.All, which
# would be every site in the tenant including HR.
#
# This fails closed. Leave DOCS_STORE unset and documents stay on local disk exactly as
# before — a forgotten variable is a deployment that still stores files, not one that
# loses them. Set DOCS_STORE=sharepoint with credentials missing and the API refuses to
# boot, rather than quietly writing to the wrong place.

# From the Entra app registration. GRAPH_CLIENT_SECRET expires — Entra caps it at 24
# months, and an unowned expiry is a scheduled outage, so write the date in the runbook.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# The composite id "host,siteCollectionId,siteId", from GET /sites/{host}:/sites/{path}.
GRAPH_SITE_ID=

# Optional: derived from the site and cached on first use. Set it only when the site has
# more than one library — one fewer variable is one fewer thing to get wrong.
GRAPH_DRIVE_ID=

# An optional prefix above everything the platform writes. Empty in production: the
# library root then holds the three buckets — Clients/, _Algemeen/ and _Exports/.
# Set it to something like _Dev on a developer machine sharing the same library.
# default: (empty)
GRAPH_ROOT_FOLDER=

# local | sharepoint
# default: local
DOCS_STORE=

# How long the first change of a burst waits for company before the month is written to
# the ledger in SharePoint. A trailing debounce, not a poll: nothing is scheduled while
# nobody is logging hours, and entering a whole week produces one write rather than one
# per entry. Only months that actually changed are written. 0 writes immediately.
# default: 5
TIME_EXPORT_DEBOUNCE_MINUTES=
