# Production stack config. Copy to deploy/.env — that file is gitignored.
#
# Local run and Hetzner use the SAME compose file; only these values differ.

# ── site ────────────────────────────────────────────────────
# Local: leave blank (Caddy serves plain HTTP on HTTP_PORT).
# Hetzner: set to the domain, e.g. platform.finsera.nl — Caddy then provisions TLS.
SITE_ADDRESS=
HTTP_PORT=8080
HTTPS_PORT=8443

# ── database ────────────────────────────────────────────────
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=platform

# ── auth (Zitadel Cloud EU — decision D5) ───────────────────
# Public under PKCE. Baked into the SPA at build time, so rebuild after changing.
ZITADEL_ISSUER=https://finsera-dashboard-nsncri.eu1.zitadel.cloud
ZITADEL_CLIENT_ID=383629804357893947

# ── LLM (decision D6) ───────────────────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MODEL_STRONG=google:gemini-3.1-pro-preview
MODEL_FAST=google:gemini-3.1-flash-lite

# ── backups ─────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
# 86400 = daily. Lower it to exercise the backup path when testing.
BACKUP_INTERVAL_SECONDS=86400
