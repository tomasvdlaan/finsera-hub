{
  "name": "finsera-platform",
  "private": true,
  "version": "0.0.1",
  "description": "Finsera internal business platform \u2014 modular monolith (see docs/)",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "boundaries": "pnpm --filter @platform/api boundaries",
    "verify": "turbo lint typecheck build test && pnpm boundaries && pnpm routes && pnpm widgets && pnpm migrations",
    "routes": "node scripts/check-routes.mjs",
    "widgets": "node scripts/check-widgets.mjs",
    "migrations": "pnpm --filter @platform/api db:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^16.10.0",
    "eslint": "^10.8.0",
    "turbo": "^2.5.0",
    "typescript-eslint": "^8.65.0"
  }
}
