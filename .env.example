# Copy to .env and fill in. .env is gitignored — secrets never enter the repo (spec §9).

# ── database ────────────────────────────────────────────────
DATABASE_URL=postgres://platform:platform@localhost:5432/platform
# The test suite truncates tables, so it gets its own database (created by `pnpm test`).
TEST_DATABASE_URL=postgres://platform:platform@localhost:5432/platform_test

# ── auth (Zitadel Cloud EU — decision D5) ───────────────────
# Public values under PKCE — the SPA holds no client secret.
ZITADEL_ISSUER=https://finsera-dashboard-nsncri.eu1.zitadel.cloud
ZITADEL_CLIENT_ID=383629804357893947

# The portal's own Zitadel APPLICATION (same project is fine — see phase7-portal-brief
# §5b). Unset means the portal refuses every request; equal to ZITADEL_CLIENT_ID is fatal.
ZITADEL_PORTAL_CLIENT_ID=

# What actually separates an employee from a client. Zitadel will issue a token carrying
# an audience the holder has no grant for, so `aud` alone is not authorisation — project
# roles are, because they come from grants. Requires "Assert Roles on Authentication".
ZITADEL_INTERNAL_ROLE=internal
ZITADEL_PORTAL_ROLE=portal_client
# The role gate is ON unless this is literally "off" — an unset or misspelled value leaves
# it enforced, so a forgotten variable cannot disable a security check. See decision log G6.
# PORTAL_ROLE_CHECK=off

# ── client portal (Phase 8) ─────────────────────────────────
# The portal signs in server-side and lives on its own hosts: <slug>.PORTAL_BASE_DOMAIN,
# with the login callback on PORTAL_AUTH_HOST. In development both are the Vite dev
# server, so the callback to register in Zitadel is
#   http://localhost:5174/api/portal-auth/callback
# and a client with slug `duce` is reachable at http://duce.localhost:5174 (browsers
# resolve *.localhost themselves). Both default to localhost:5174 when unset.
# PORTAL_BASE_DOMAIN=localhost:5174
# PORTAL_AUTH_HOST=localhost:5174
# Signs the in-flight login state; random per boot when unset outside production.
# PORTAL_SESSION_SECRET=
# Blank keeps the portal application public (PKCE only), which is what it is today.
# ZITADEL_PORTAL_CLIENT_SECRET=
# Encrypts per-page Vercel bypass secrets: `openssl rand -base64 32`. Unset means a page
# can only point at a deployment that is publicly reachable.
# PORTAL_PAGE_KEY=
# The project whose roles count. Optional, and worth setting once you know the value.
#
# Leave it empty and a single project-scoped roles claim is accepted whatever project it
# names — which is what makes an unconfigured instance work at all, since Zitadel Cloud
# emits the scoped form. Set it and only that project's roles are read, so a grant in
# another project cannot be mistaken for one here.
#
# Take the value from GET /core/auth/diagnostics once roles are arriving: it prints the
# roles claim names verbatim. Do NOT guess it from the token's `aud` — one of those
# entries is the client id, and setting the wrong one makes the check strict against a
# project that will never answer.
ZITADEL_PROJECT_ID=

# ── Creating client logins from the hub (Portal access → Give access) ────────────
#
# A personal access token for a Zitadel SERVICE USER, not a person: the hub uses it to
# create a client's account, grant it the portal role and mint a one-time registration
# link, which a colleague then sends in their own email. Unset, everything else still
# works — the invitation is written and the account is made by hand in the console, as
# before — and the screen says why no link appeared.
#
# The service user needs to manage users and grants in this organisation
# (ORG_USER_MANAGER plus project-grant rights, or ORG_OWNER for simplicity).
ZITADEL_ADMIN_TOKEN=

# Which organisation new client accounts belong to. Blank means the token's own, which is
# right unless you run more than one.
ZITADEL_ORG_ID=

# Where a registration link points. The default is Zitadel's hosted invite page:
#   ${ZITADEL_ISSUER}/ui/login/user/invite?userID={userId}&code={code}
# Zitadel has moved this path between versions, and a link that 404s is the one failure a
# client cannot work around — so send one real invitation, read the URL in the mail, and
# set this if the shape differs. {userId}, {code} and {orgId} are substituted.
ZITADEL_INVITE_URL=

# ── LLM provider interface (decision D6) ────────────────────
# Model strings are 'provider:model'. Swapping provider or model is an env change —
# no module imports a vendor SDK directly, so nothing else moves.
#
# Anthropic (the intended production default — strongest multi-step tool use):
ANTHROPIC_API_KEY=
# Google Gemini — PAID tier (free tier may train on prompts; see decision D6a):
GOOGLE_GENERATIVE_AI_API_KEY=

# Provider is the prefix — switching vendor is this line plus a key (decision D6a).
MODEL_STRONG=google:gemini-3.1-pro-preview
MODEL_FAST=google:gemini-3.1-flash-lite
# On Anthropic instead:
# MODEL_STRONG=anthropic:claude-opus-4-8
# MODEL_FAST=anthropic:claude-haiku-4-5-20251001

# ── file storage (Phase 3) ──────────────────────────────────
# Only the local driver exists; the s3 driver arrives with Hetzner object storage.
STORAGE_DRIVER=local
STORAGE_PATH=./storage
MODEL_EMBEDDING=google:gemini-embedding-001

# ── meeting capture (Phase 6c, decision G3) ──────────────────
# Recall.ai joins the Teams meeting as a bot and streams one audio channel per
# participant back to us, each tagged with that person's roster identity.
#
# Use the EU region. The default in code is Frankfurt; setting the US endpoint here
# would quietly undo the reason this vendor was acceptable at all.
RECALL_API_KEY=
RECALL_REGION_URL=https://eu-central-1.recall.ai

# Recall connects TO us, so this must be an address Recall can reach from the internet.
# In development that means a tunnel (e.g. `ngrok http 3001`), not localhost.
RECALL_WEBHOOK_BASE=

# ── documents in SharePoint (decision D8) ───────────────────
# One Entra app registration, app-only client credentials, granted Sites.Selected on ONE
# site — the documents site, not FinseraHub. Sites.Selected scopes at SITE level, so a
# folder inside the existing site would still hand this credential write access to 05_HR
# and every client's bookkeeping. Never grant Sites.ReadWrite.All: that is every site in
# the tenant.
#
# Staff open files in Word Online as themselves, through their own SharePoint permission
# on that site. This credential is how the platform files, reads and indexes — not how a
# person edits.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# The composite id from GET /sites/{host}:/sites/{path} — "host,siteCollectionId,siteId".
GRAPH_SITE_ID=
# Optional. Resolved from the site and cached when unset; set it only if the site has more
# than one document library.
GRAPH_DRIVE_ID=
# Everything the platform files lives under this folder, created on first use.
GRAPH_ROOT_FOLDER=Clients
# Fails closed: unset or unrecognised means documents keep going to local disk, exactly as
# today. Flipping this to 'sharepoint' is the whole switch.
DOCS_STORE=local

# How long the first change of a burst waits for company before the month is written.
# A trailing debounce, not a poll: nothing is scheduled while nobody is logging hours,
# and a Friday afternoon of entering the week produces one write rather than one per
# entry. 0 means write as soon as the entry is saved.
TIME_EXPORT_DEBOUNCE_MINUTES=5
