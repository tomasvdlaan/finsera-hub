# Copy to .env and fill in. .env is gitignored — secrets never enter the repo (spec §9).

# ── database ────────────────────────────────────────────────
DATABASE_URL=postgres://platform:platform@localhost:5432/platform
# The test suite truncates tables, so it gets its own database (created by `pnpm test`).
TEST_DATABASE_URL=postgres://platform:platform@localhost:5432/platform_test

# ── auth (Zitadel Cloud EU — decision D5) ───────────────────
# Public values under PKCE — the SPA holds no client secret.
ZITADEL_ISSUER=https://finsera-dashboard-nsncri.eu1.zitadel.cloud
ZITADEL_CLIENT_ID=383629804357893947

# ── LLM provider interface (decision D6) ────────────────────
# Model strings are 'provider:model'. Swapping provider or model is an env change —
# no module imports a vendor SDK directly, so nothing else moves.
#
# Anthropic (the intended production default — strongest multi-step tool use):
ANTHROPIC_API_KEY=
# Google Gemini — PAID tier (free tier may train on prompts; see decision D6a):
GOOGLE_GENERATIVE_AI_API_KEY=

# Provider is the prefix — switching vendor is this line plus a key (decision D6a).
MODEL_STRONG=google:gemini-3.1-pro-preview
MODEL_FAST=google:gemini-3.1-flash-lite
# On Anthropic instead:
# MODEL_STRONG=anthropic:claude-opus-4-8
# MODEL_FAST=anthropic:claude-haiku-4-5-20251001

# ── file storage (Phase 3) ──────────────────────────────────
# Only the local driver exists; the s3 driver arrives with Hetzner object storage.
STORAGE_DRIVER=local
STORAGE_PATH=./storage
MODEL_EMBEDDING=google:gemini-embedding-001

# ── meeting capture (Phase 6c, decision G3) ──────────────────
# Recall.ai joins the Teams meeting as a bot and streams one audio channel per
# participant back to us, each tagged with that person's roster identity.
#
# Use the EU region. The default in code is Frankfurt; setting the US endpoint here
# would quietly undo the reason this vendor was acceptable at all.
RECALL_API_KEY=276b2c4aa55f9fab7719c86c01a212b48bb00020
RECALL_REGION_URL=https://eu-central-1.recall.ai

# Recall connects TO us, so this must be an address Recall can reach from the internet.
# In development that means a tunnel (e.g. `ngrok http 3001`), not localhost.
RECALL_WEBHOOK_BASE=
