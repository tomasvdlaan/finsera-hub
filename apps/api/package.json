{
  "name": "@platform/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "node scripts/setup-test-db.mjs && vitest run",
    "db:test:setup": "node scripts/setup-test-db.mjs",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-migrations.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.21",
    "@ai-sdk/google": "^4.0.24",
    "@breezystack/lamejs": "^1.2.7",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-ws": "^11.1.28",
    "@nestjs/websockets": "^11.1.28",
    "@platform/contracts": "workspace:*",
    "@platform/note-doc": "workspace:*",
    "ai": "^7.0.37",
    "drizzle-orm": "^0.38.0",
    "jose": "^5.9.0",
    "mammoth": "^1.12.0",
    "nestjs-pino": "^4.2.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "unpdf": "^1.8.0",
    "uuid": "^11.0.0",
    "ws": "^8.21.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@platform/config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.1",
    "dependency-cruiser": "^16.10.4",
    "drizzle-kit": "^0.30.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
